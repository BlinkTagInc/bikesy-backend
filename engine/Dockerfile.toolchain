FROM node:22.14.0-bookworm-slim@sha256:745403dc46b5ab4c998502b07a12cbf020cf2c30645427a68ec0718f02d647de AS node
FROM ghcr.io/valhalla/valhalla@sha256:f58558b2164ec7fa6f6ee9199cea06e18ac8217da24e7faa7718ea526a88ac1a
COPY --from=node /usr/local/bin/node /usr/local/bin/node
USER root
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends g++ osmium-tool libboost-dev libprotobuf-dev libcurl4-openssl-dev libzmq3-dev libczmq-dev libboost-program-options-dev libboost-filesystem-dev libboost-system-dev libboost-regex-dev libboost-date-time-dev libboost-thread-dev liblz4-dev zlib1g-dev rapidjson-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /build
