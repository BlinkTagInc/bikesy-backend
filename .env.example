# The container already sets these defaults. No API key is required.
PORT=80
BIKESY_CONFIG=/app/config/sample.json
MAX_CONCURRENT_ROUTES=2
# For running the JS adapter alone against a separately running local engine:
# BIKESY_CONFIG=./config/sample.json
# VALHALLA_URL=http://127.0.0.1:8002/
# PORT=8080
# HOST=127.0.0.1
